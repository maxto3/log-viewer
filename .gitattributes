# Line endings: the repository stores LF, the checkout follows the platform.
* text=auto

# Unix side scripts and the Linux packaging files must keep LF so they stay
# executable after a checkout on Linux (a CRLF shebang would break them).
*.sh            text eol=lf
*.desktop.in    text eol=lf
*.metainfo.xml  text eol=lf
packaging/linux/** text eol=lf

# Windows scripts and build files: CRLF is the natural choice on checkout.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets are never converted.
*.png  binary
*.ico  binary
*.qm   binary
